{
  "uid": "community-search",
  "title": "커뮤니티 검색 실험",
  "schemaVersion": 39,
  "tags": [
    "search"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 13,
      "title": "01  현재 상태",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "DB 연결 풀 점유율",
      "description": "사용 중인 연결을 풀의 최대 연결 수로 나눈 비율입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 0,
          "noValue": "수집 대기",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * hikaricp_connections_active{job=\"search-backend\"} / hikaricp_connections_max{job=\"search-backend\"}",
          "legendFormat": "{{pool}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "DB 연결 대기 요청",
      "description": "현재 연결을 기다리는 요청 수입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "수집 대기",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{job=\"search-backend\"}",
          "legendFormat": "{{pool}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "EC2 CPU 사용률",
      "description": "최근 2분 평균입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 0,
          "noValue": "수집 대기",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"search-host\",mode=\"idle\"}[2m])))",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "EC2 메모리 사용률",
      "description": "재사용 가능한 캐시를 포함한 가용 메모리 기준입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 0,
          "noValue": "수집 대기",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"search-host\"} / node_memory_MemTotal_bytes{job=\"search-host\"})",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "title": "02  요청과 자원 사용 추이",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "title": "게시글 목록 API 응답시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"search-backend\",uri=\"/posts\",method=\"GET\"}[2m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"search-backend\",uri=\"/posts\",method=\"GET\"}[2m])))",
          "legendFormat": "P99",
          "instant": false,
          "range": true
        }
      ],
      "description": "일반 목록과 검색을 함께 집계합니다. 검색 전용 지연은 k6 결과에서 확인합니다."
    },
    {
      "id": 11,
      "title": "게시글 목록 요청률과 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "description": "최근 2분 기준 초당 요청과 5xx 응답 건수입니다.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"search-backend\",uri=\"/posts\",method=\"GET\"}[2m]))",
          "legendFormat": "전체 요청",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"search-backend\",uri=\"/posts\",method=\"GET\",status=~\"5..\"}[2m])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"search-backend\",uri=\"/posts\",method=\"GET\"}[2m])))",
          "legendFormat": "5xx",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HikariCP 연결 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{job=\"search-backend\"}",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "EC2 CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"search-host\",mode=\"idle\"}[2m])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "MySQL EC2 디스크 읽기·쓰기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"search-host\",instance=\"mysql\",device=~\"nvme[0-9]+n[0-9]+\"}[2m])",
          "legendFormat": "읽기 {{device}}"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{job=\"search-host\",instance=\"mysql\",device=~\"nvme[0-9]+n[0-9]+\"}[2m])",
          "legendFormat": "쓰기 {{device}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "EC2 여유 메모리",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "search-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"search-host\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "03  서비스 로그",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "title": "경고·오류 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "search-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 9
      },
      "description": "백엔드·MySQL의 경고 및 오류와 Nginx의 HTTP 4xx·5xx를 모아 봅니다.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"community-search-(${log_service:regex})\"} |~ `(?i)(\\b(warn(ing)?|error|fatal)\\b|\"\\s+[45][0-9]{2}\\s+request_time=)` | line_format `[{{.container}}] {{ __line__ }}`"
        }
      ]
    },
    {
      "id": 6,
      "title": "전체 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "search-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"community-search-(${log_service:regex})\"} | line_format `[{{.container}}] {{ __line__ }}`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#5794F2",
        "name": "k6 시험 구간",
        "target": {
          "type": "dashboard",
          "limit": 100,
          "matchAny": false,
          "tags": []
        },
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "log_service",
        "label": "로그 서비스",
        "type": "custom",
        "query": "백엔드 : backend,Nginx : nginx,MySQL : mysql",
        "includeAll": true,
        "allValue": "backend|nginx|mysql",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
