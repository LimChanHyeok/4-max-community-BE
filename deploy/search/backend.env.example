# 비밀값을 제외한 백엔드 실행 설정 예시다.
# DB 주소는 Terraform 출력의 MySQL 사설 IP로 변경한다.
DB_URL=jdbc:mysql://10.20.1.20:3306/community_search?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=community_search

# 기존 로컬 설정과 같은 만료 시간을 초기값으로 사용한다. 단위는 ms다.
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# 브라우저 프론트엔드를 연결할 때 실제 프론트 출처로 변경한다.
# k6·curl처럼 브라우저가 아닌 클라이언트에는 CORS 제한이 적용되지 않는다.
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
AWS_REGION=ap-northeast-2
APP_AWS_S3_BUCKET=community-board-images-prod

# 기존 공통 설정의 업로드 제한을 서버 실행 환경에도 전달한다.
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
