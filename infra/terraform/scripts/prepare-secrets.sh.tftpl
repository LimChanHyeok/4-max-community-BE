
# 최초 서버 구성에서만 Parameter Store 값을 읽는다. 재부팅 때 다시 실행하지 않는다.
# 설정에는 파라미터 이름과 파일 경로만 들어가며 비밀값은 포함하지 않는다.
python3 - <<'PYTHON'
import base64
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

settings = json.loads(base64.b64decode("${settings_base64}"))


def prepare_secrets():
    if os.geteuid() != 0:
        raise RuntimeError("비밀번호 파일 준비에는 root 권한이 필요합니다.")

    names = list(settings["files"].values())
    environment = os.environ.copy()
    environment.update(AWS_PAGER="", AWS_CLI_AUTO_PROMPT="off",
                       AWS_RETRY_MODE="standard", AWS_MAX_ATTEMPTS="5")
    # 응답에 비밀값이 있으므로 표준 출력이나 cloud-init 로그로 전달하지 않는다.
    result = subprocess.run(
        ["aws", "ssm", "get-parameters", "--region", settings["region"],
         "--names", *names, "--with-decryption", "--output", "json"],
        capture_output=True, text=True, env=environment, timeout=120,
    )
    if result.returncode != 0:
        raise RuntimeError("Parameter Store 조회에 실패했습니다. 리전과 IAM 권한을 확인하세요.")
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError:
        raise RuntimeError("Parameter Store 응답 형식을 확인할 수 없습니다.") from None
    if response.get("InvalidParameters"):
        raise RuntimeError("필요한 파라미터가 없습니다. 서버 생성 전에 값을 등록하세요.")

    # GetParameters 응답은 요청 순서와 다를 수 있어 이름으로 대응시킨다.
    parameters = {item["Name"]: item for item in response.get("Parameters", [])}
    for filename, name in settings["files"].items():
        item = parameters.get(name)
        if item is None or item.get("Type") != "SecureString":
            raise RuntimeError("필요한 파라미터가 없거나 SecureString 타입이 아닙니다.")
        value = item.get("Value")
        if not isinstance(value, str) or not value:
            raise RuntimeError("비밀번호 또는 JWT 키가 비어 있습니다.")
        if "\x00" in value or "\r" in value or "\n" in value:
            raise RuntimeError("비밀번호와 JWT 키는 줄바꿈 없는 단일 문자열로 등록하세요.")
        if filename == "jwt-secret" and len(value.encode("utf-8")) < 32:
            raise RuntimeError("JWT 서명 키는 UTF-8 기준 32바이트 이상이어야 합니다.")

    # 모든 값 확인이 끝나야 파일을 기록한다. 기존 파일은 원자적으로 교체한다.
    directory = Path(settings["directory"])
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chown(directory, 0, 0)
    os.chmod(directory, 0o700)
    for filename, name in settings["files"].items():
        descriptor, temporary = tempfile.mkstemp(prefix=".parameter-", dir=directory)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as output:
                os.fchown(output.fileno(), 0, settings["group_id"])
                os.fchmod(output.fileno(), int(settings["file_mode"], 8))
                output.write(parameters[name]["Value"])
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, directory / filename)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    print("Parameter Store 비밀값 파일 준비 완료: " + settings["role"])


try:
    prepare_secrets()
except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
    # AWS CLI 응답이나 복호화한 값을 오류 메시지에 포함하지 않는다.
    if isinstance(error, RuntimeError):
        print(str(error), file=sys.stderr)
    else:
        print("비밀값 파일 준비에 실패했습니다. 파일 권한과 AWS 연결을 확인하세요.", file=sys.stderr)
    sys.exit(1)
PYTHON
